// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "webpack: compile",
            "type": "npm",
            "script": "compile",
            "group": "build",
            "problemMatcher": "$webpack-stamp"
        },
        {
            "label": "webpack: watch",
            "type": "npm",
            "script": "watch",
            "problemMatcher": {
                "owner": "webpack",
                "pattern": {
                    "regexp": "^\\s*ERROR in (.+)$",
                    "file": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "compiled successfully|compiled with|Failed to compile"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "tsc: watch-tests",
            "type": "npm",
            "script": "watch-tests",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "group": "build"
        },
        {
            "label": "tasks: watch-tests",
            "dependsOn": ["webpack: watch", "tsc: watch-tests"],
            "problemMatcher": []
        }
    ]
}
